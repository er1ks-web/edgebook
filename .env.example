# Live odds from https://the-odds-api.com (the free plan has a monthly credit limit).
# Leave empty to run on clearly labelled demo data.
ODDS_API_KEY=

# Claude research layer, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Login. There is one account and no signup. Required anywhere but local development:
# without these, a hosted app stays locked. The password needs at least 10 characters.
APP_USERNAME=
APP_PASSWORD=

# Where data is saved. On a host, point this at a persistent disk, such as /data.
DATA_DIR=
